# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# KHÔNG commit file .env.

# Gửi email OTP (SendGrid)
SENDGRID_API_KEY=

# Tra cứu mã số thuế doanh nghiệp
TAX_CODE_ENDPOINT=

# Thanh toán payOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Thanh toán SePay (webhook chuyển khoản)
SEPAY_API_URL=https://my.sepay.vn
SEPAY_ACCESS_TOKEN=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
