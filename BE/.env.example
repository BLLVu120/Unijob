# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# KHÔNG commit file .env.

# PostgreSQL (mặc định khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unijob_db
DB_USER=unijob_user
DB_PASSWORD=

# Tra cứu mã số thuế doanh nghiệp
TAX_CODE_ENDPOINT=

# Gửi email OTP (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Thanh toán VNPay (Sandbox) — đăng ký tại https://sandbox.vnpayment.vn/devreg/
# VNPay gửi Terminal ID (vnp_TmnCode) và Secret Key (vnp_HashSecret) qua email.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Tuỳ chọn, mặc định là cổng sandbox:
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# CORS: các origin của FE được phép gọi API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
