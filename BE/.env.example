# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# KHÔNG commit file .env.

# PostgreSQL (mặc định khớp với Backend/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unijob_db
DB_USER=unijob_user
DB_PASSWORD=

# Tra cứu mã số thuế doanh nghiệp
TAX_CODE_ENDPOINT=

# Gửi email OTP (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Thanh toán payOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# CORS: các origin của FE được phép gọi API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
